# Default all text files to LF
* text=auto eol=lf

# Force LF on shell scripts, Rust, Kotlin, Gradle, and JSON vectors
*.sh text eol=lf
*.rs text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
gradlew text eol=lf

# Force CRLF strictly on Windows batch, PowerShell, and Inno Setup files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf
*.rc text eol=crlf

# Binary files
*.png binary
*.ico binary
*.woff2 binary
*.ttf binary

# GitHub Linguist: Keep repo language stats 100% Rust + Kotlin
landing/** linguist-vendored
design/prototypes/** linguist-documentation
docs/** linguist-documentation
