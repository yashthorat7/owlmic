#!/usr/bin/env bash
set -euo pipefail

echo "=========================================="
echo "🦅 Owlmic Pre-Push Verification"
echo "=========================================="

# Run unified pre-flight checks (invariants, desktop checks, android tests)
if python -c "import sys" >/dev/null 2>&1; then
    python scripts/check.py
elif py -3 -c "import sys" >/dev/null 2>&1; then
    py -3 scripts/check.py
elif python3 -c "import sys" >/dev/null 2>&1; then
    python3 scripts/check.py
else
    echo "❌ Python 3 is required to run pre-flight checks."
    exit 1
fi
