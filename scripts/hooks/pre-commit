#!/usr/bin/env bash
set -euo pipefail

BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

# Skip checks on detached HEAD or main
if [ "$BRANCH_NAME" != "HEAD" ] && [ "$BRANCH_NAME" != "main" ]; then
    PATTERN="^(feat|fix|docs|refactor|perf|test|chore|build|ci)/[a-z0-9-]+$"
    if ! echo "$BRANCH_NAME" | grep -qE "$PATTERN"; then
        echo "⚠️ WARNING: Branch name '$BRANCH_NAME' does not match style: <type>/<short-kebab-description>"
        echo "Allowed types: feat, fix, docs, refactor, perf, test, chore, build, ci"
        echo "Example: refactor/repo-refactoring"
    fi
fi

if python -c "import sys" >/dev/null 2>&1; then
    python scripts/verify-repo-invariants.py
elif py -3 -c "import sys" >/dev/null 2>&1; then
    py -3 scripts/verify-repo-invariants.py
elif python3 -c "import sys" >/dev/null 2>&1; then
    python3 scripts/verify-repo-invariants.py
fi

if git diff --cached --name-only | grep -q "^pc/"; then
    echo "→ Running cargo fmt on pc/..."
    (cd pc && cargo fmt --all --check)
fi
