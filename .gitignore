# =============================================================================
# 1. STRICT BINARY & ARCHIVE BAN (Enforced by scripts/verify-repo-invariants.py)
# =============================================================================
*.exe
*.dll
*.so
*.dylib
*.apk
*.aab
*.ap_
*.dex
*.class
*.o
*.obj
*.lib
*.a
*.pdb
*.ilk
*.exp
*.msi
*.deb
*.rpm
*.AppImage
*.zip
*.tar.gz
*.7z
*.iso

# =============================================================================
# 2. RUST & DESKTOP WORKSPACE (desktop/)
# =============================================================================
/desktop/target/
**/target/
**/*.rs.bk
Cargo.lock.bak
# Centralized distributables and packaging cache
/dist/
scripts/packaging/cache/
scripts/packaging/windows/Output/
scripts/packaging/windows/driver/
scripts/packaging/linux/build/
scripts/packaging/linux/AppDir/

# =============================================================================
# 3. ANDROID NDK / GRADLE / KOTLIN (android/)
# =============================================================================
/android/.gradle/
/android/build/
/android/**/build/
/android/.cxx/
/android/**/.cxx/
/android/local.properties
/android/captures/
/android/.navigation/
/android/**/*.iml
/android/.idea/

# Signing keys & secrets (NEVER COMMIT)
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.der
key.properties
google-services.json

# =============================================================================
# 4. WEBSITE & NODE (website/)
# =============================================================================
/website/node_modules/
/website/dist/
/website/.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.env
.env.*
!.env.example

# =============================================================================
# 5. IDE, EDITOR, PYTHON & OS ARTIFACTS (Windows, Linux, macOS)
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
