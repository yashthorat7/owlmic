# =============================================================================
# 1. STRICT BINARY & ARCHIVE BAN (Enforced by scripts/verify-repo-invariants.py)
# =============================================================================
*.exe
*.dll
*.so
*.dylib
*.apk
*.aab
*.ap_
*.dex
*.class
*.o
*.obj
*.lib
*.a
*.pdb
*.ilk
*.exp
*.msi
*.deb
*.rpm
*.AppImage
*.zip
*.tar.gz
*.7z
*.iso

# =============================================================================
# 2. RUST & PC WORKSPACE (pc/)
# =============================================================================
/pc/target/
**/target/
**/*.rs.bk
Cargo.lock.bak
# Inno Setup & Windows Installer outputs
/pc/installer/**/Output/
/pc/installer/**/*.exe
/pc/installer/**/driver/
# Linux packaging build directories
/pc/installer/linux/build/
/pc/installer/linux/AppDir/

# =============================================================================
# 3. ANDROID NDK / GRADLE / KOTLIN (android/)
# =============================================================================
/android/.gradle/
/android/build/
/android/**/build/
/android/.cxx/
/android/**/.cxx/
/android/local.properties
/android/captures/
/android/.navigation/
/android/**/*.iml
/android/.idea/

# Signing keys & secrets (NEVER COMMIT)
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.der
key.properties
google-services.json

# =============================================================================
# 4. LANDING SITE & NODE (landing/)
# =============================================================================
/landing/node_modules/
/landing/dist/
/landing/.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.env
.env.*
!.env.example

# =============================================================================
# 5. IDE, EDITOR & OS ARTIFACTS (Windows, Linux, macOS)
# =============================================================================
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*trash.md
